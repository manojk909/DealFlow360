# Copy to .env and edit. The app runs on defaults without one — this file only exists so
# a non-default SECRET_KEY and DEBUG=False are possible without editing settings.py.
#
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
